<Window x:Class="PetPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rp-desktop-pet"
        Width="400" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
      <SolidColorBrush x:Key="Ink" Color="#24404C"/>
      <SolidColorBrush x:Key="BodyBrush" Color="#8FD3E8"/>
      <SolidColorBrush x:Key="FinBrush" Color="#6FB7C9"/>
      <SolidColorBrush x:Key="BellyBrush" Color="#EAF7FB"/>
      <SolidColorBrush x:Key="BubbleFill" Color="#EFF7FB"/>
      <SolidColorBrush x:Key="BubbleStroke" Color="#A9D8E6"/>

      <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="#2224404C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="#3324404C"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Canvas>
      <Ellipse x:Name="ShadowEllipse" Canvas.Left="150" Canvas.Top="338"
               Width="100" Height="14" Fill="#22000000" IsHitTestVisible="False"/>

      <StackPanel x:Name="BubbleStack" Canvas.Left="36" Canvas.Top="26" Width="328"
                  Visibility="Collapsed">
        <Border Background="{StaticResource BubbleFill}" BorderBrush="{StaticResource BubbleStroke}"
                BorderThickness="1" CornerRadius="16" Padding="14,10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#1B3A46"/>
          </Border.Effect>
          <TextBlock x:Name="BubbleText" FontSize="14" LineHeight="22"
                     Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
        </Border>
        <Polygon Points="0,0 16,0 8,10" Fill="{StaticResource BubbleFill}"
                 HorizontalAlignment="Center" Margin="0,-1,0,0" IsHitTestVisible="False"/>
      </StackPanel>

      <TextBlock x:Name="Dots" Text="…" FontSize="22" Foreground="#8FB3C1"
                 Canvas.Left="192" Canvas.Top="132" Visibility="Collapsed"
                 IsHitTestVisible="False"/>

      <Border x:Name="Hint" Canvas.Left="190" Canvas.Top="160" Width="44" Height="26"
              CornerRadius="13" Background="#F2FFFFFF" BorderBrush="{StaticResource BubbleStroke}"
              BorderThickness="1" Cursor="Hand" ToolTip="和瑾瑜说话">
        <TextBlock Text="…" FontSize="14" Foreground="{StaticResource Ink}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <Canvas x:Name="Whale" Canvas.Left="90" Canvas.Top="190" Width="220" Height="160"
              Background="Transparent" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
        <Canvas.ContextMenu>
          <ContextMenu>
            <MenuItem Header="换配色" Click="MenuPalette_Click"/>
            <MenuItem x:Name="QuietItem" Header="静音 / 勿扰" Click="MenuQuiet_Click"/>
            <MenuItem Header="隐藏（Ctrl+Alt+J 召回）" Click="MenuHide_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="MenuQuit_Click"/>
          </ContextMenu>
        </Canvas.ContextMenu>

        <Path x:Name="SpoutPath" Stroke="{StaticResource FinBrush}" StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85" IsHitTestVisible="False"
              Data="M108,34 C100,22 92,26 96,36 C88,30 82,38 90,44"/>
        <Path x:Name="TailPath" Fill="{StaticResource FinBrush}" IsHitTestVisible="False"
              Data="M46,78 C28,60 10,58 6,70 C2,84 20,96 40,92 Z"/>
        <Ellipse x:Name="BodyEllipse" Canvas.Left="42" Canvas.Top="38" Width="140" Height="92"
                 Fill="{StaticResource BodyBrush}" IsHitTestVisible="False"/>
        <Ellipse x:Name="BellyEllipse" Canvas.Left="64" Canvas.Top="84" Width="92" Height="40"
                 Fill="{StaticResource BellyBrush}" IsHitTestVisible="False"/>
        <Path x:Name="FlipperPath" Fill="{StaticResource FinBrush}" IsHitTestVisible="False"
              Data="M96,104 C86,122 100,128 110,112 Z"/>

        <Canvas x:Name="Eye" Canvas.Left="132" Canvas.Top="64" Width="20" Height="18"
                RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
          <Canvas.RenderTransform>
            <ScaleTransform x:Name="EyeScale"/>
          </Canvas.RenderTransform>
          <Ellipse Width="16" Height="16" Fill="White"/>
          <Canvas x:Name="PupilGroup" Canvas.Left="5" Canvas.Top="5" Width="10" Height="10">
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="PupilShift"/>
            </Canvas.RenderTransform>
            <Ellipse Width="8" Height="8" Fill="{StaticResource Ink}"/>
            <Ellipse Canvas.Left="4.6" Canvas.Top="0.6" Width="2.8" Height="2.8" Fill="White"/>
          </Canvas>
        </Canvas>

        <Path x:Name="MouthPath" Stroke="{StaticResource Ink}" StrokeThickness="2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" IsHitTestVisible="False"
              Data="M134,94 Q142,99 150,94"/>
        <Ellipse x:Name="BlushEllipse" Canvas.Left="145" Canvas.Top="81" Width="16" Height="9"
                 Fill="#F2A6B8" Opacity="0.55" IsHitTestVisible="False"/>
      </Canvas>

      <Border x:Name="Capsule" Canvas.Left="40" Canvas.Top="300" Width="320" Height="50"
              CornerRadius="25" Background="{StaticResource BubbleFill}"
              BorderBrush="{StaticResource BubbleStroke}" BorderThickness="1"
              Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.2" Color="#1B3A46"/>
        </Border.Effect>
        <Grid>
          <TextBlock x:Name="Placeholder" Text="和瑾瑜说点什么…" Foreground="#7E9BA8"
                     FontSize="14" Margin="22,0,0,0" VerticalAlignment="Center"
                     IsHitTestVisible="False"/>
          <TextBox x:Name="Input" Margin="20,0,88,0" VerticalContentAlignment="Center"
                   Background="Transparent" BorderThickness="0" FontSize="14"
                   Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}"
                   MaxLength="500"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="0,0,10,0">
            <Button x:Name="MicButton" Content="🎤" Width="34" Height="34" FontSize="15"
                    Style="{StaticResource GhostButton}"/>
            <Button x:Name="SendButton" Content="➤" Width="34" Height="34" FontSize="15"
                    Style="{StaticResource GhostButton}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="ToastBorder" Canvas.Left="110" Canvas.Top="344" Width="180" Height="26"
              CornerRadius="13" Background="#E624404C" Visibility="Collapsed"
              IsHitTestVisible="False">
        <TextBlock x:Name="ToastText" Foreground="White" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Canvas>
  </Grid>
</Window>
